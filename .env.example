# development | production (production: JSON logs, stricter JWT secret checks)
APP_ENV="development"
APP_PORT="8080"

DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# disable (local Postgres without TLS) | prefer | require (managed/remote DB)
DATABASE_SSLMODE="require"
DATABASE_MAX_OPEN_CONNECTIONS=10
DATABASE_MAX_IDLE_CONNECTIONS=10

# Leave REDIS_HOST empty to use the in-memory cache (single instance; logouts are lost on restart)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TTL_PRICE=60

# Required, no defaults: the server will not start without them. They must differ, and in
# production be at least 32 characters. Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION_TIME="1h"
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION_TIME="168h"

# Optional CoinGecko Demo/Pro key (raises the rate limit). Prices work without it.
CRYPTO_PRICE_API_KEY=

RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=1000

# CORS: * or comma-separated origins, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=*
