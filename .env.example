APP_ENV="development"
APP_PORT="8080"

DATABASE_PORT="5432"
DATABASE_HOST="localhost"
DATABASE_USER=""
DATABASE_PASSWORD=""
DATABASE_NAME=""
# disable (local without TLS) | prefer (default) | require (managed/remote DB, recommended in production)
DATABASE_SSLMODE="prefer"
DATABASE_MAX_OPEN_CONNECTIONS=10
DATABASE_MAX_IDLE_CONNECTIONS=10

REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_PRICE=60

JWT_SECRET="secret"
JWT_EXPIRATION_TIME="1h"
JWT_REFRESH_SECRET="refresh_secret"
JWT_REFRESH_EXPIRATION_TIME="1h"

# Crypto prices: CoinGecko. Works without a key; a free Demo key (coingecko.com/api)
# raises the rate limit. For a Pro key use CRYPTO_PRICE_API=https://pro-api.coingecko.com/api/v3
CRYPTO_PRICE_API=https://api.coingecko.com/api/v3
CRYPTO_PRICE_API_KEY=
# Stock prices and intraday FX: Yahoo Finance (free, no API key needed)
# IDX stocks are stored with the .JK suffix (BBCA.JK); bare known IDX tickers still resolve
STOCK_PRICE_API=https://query1.finance.yahoo.com
# Fallback exchange rates when Yahoo FX is unavailable (free, no key, daily rates)
FX_PRICE_API=https://open.er-api.com/v6

BCRYPT_SALT_ROUNDS=8

RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=1000

# CORS: * or comma-separated origins, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=*

LOG_LEVEL=debug