# development | production (production: JSON logs, stricter JWT secret checks)
APP_ENV="development"
APP_PORT="8080"

DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# disable (local Postgres without TLS) | prefer | require (managed/remote DB)
DATABASE_SSLMODE="require"
DATABASE_MAX_OPEN_CONNECTIONS=10
DATABASE_MAX_IDLE_CONNECTIONS=10

# Leave REDIS_HOST empty to use the in-memory cache (single instance; logouts are lost on restart)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TTL_PRICE=60

# Required, no defaults: the server will not start without them. They must differ, and in
# production be at least 32 characters. Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION_TIME="1h"
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION_TIME="168h"

# Optional CoinGecko Demo/Pro key (raises the rate limit). Prices work without it.
CRYPTO_PRICE_API_KEY=

# Yahoo Finance (stocks, FX). Leave empty for direct access. Yahoo answers 429 to many datacenter
# IPs; then point STOCK_API_URL at a relay (see relay/yahoo-worker.js) and/or set a proxy.
STOCK_API_URL=
# Optional proxy for Yahoo requests only: http://user:pass@host:port or socks5://host:port
STOCK_API_PROXY=
# Sent as X-Relay-Token; must match the relay's RELAY_TOKEN. Generate with: openssl rand -hex 32
STOCK_API_RELAY_TOKEN=

RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=1000

# Origins whose browser pages may call the API directly, comma-separated, e.g. https://app.example.com.
# Leave empty when the frontend uses its /api/v1 rewrite (no cross-origin access). "*" is refused in
# production. Also the trusted-origin list for the CSRF check. CORS does not block curl/scripts/servers.
CORS_ALLOWED_ORIGINS=

# Auth cookies (HttpOnly, SameSite=Lax). The browser reaches the API through the frontend's /api/v1
# rewrite, so the cookies belong to the frontend's domain. COOKIE_SECURE defaults to true when
# APP_ENV=production. COOKIE_DOMAIN is optional; leave empty for host-only cookies.
COOKIE_SECURE=
COOKIE_DOMAIN=

# Shared secret the frontend server sends as X-Internal-Token; requests without it get 403 (except
# GET /health and GET /). Required in production (32+ chars); empty disables the check in development.
# Set the same value as INTERNAL_API_TOKEN in the frontend's server env. Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=
