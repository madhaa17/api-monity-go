{
	"info": {
		"name": "Monity — Finance Tracker API",
		"description": "Complete API collection for Monity finance tracker backend.\n\n**Setup:**\n1. Set `base_url` variable (e.g. `http://localhost:8080` or `https://api-assetmonitor.my.id`)\n2. Call Login/Register — token is auto-saved to `token` variable\n3. All authenticated requests use `{{token}}` in Bearer header\n\n**Variable auto-capture:**\n- Login/Register → `token`, `refresh_token`\n- Create Asset → `asset_uuid`, `cash_asset_uuid` (if CASH)\n- Create Category → `category_uuid` (set `income_category_uuid` and `reassign_category_uuid` by hand from List Categories)\n- Create Expense → `expense_uuid`\n- Create Income → `income_uuid`\n- Create Saving Goal → `saving_goal_uuid`\n- Create Debt → `debt_uuid`\n- Create Receivable → `receivable_uuid`\n\n**Default currency:** IDR (all endpoints default to IDR if no `?currency=` param)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8080", "type": "string" },
		{ "key": "token", "value": "", "type": "string" },
		{ "key": "refresh_token", "value": "", "type": "string" },
		{ "key": "asset_uuid", "value": "", "type": "string" },
		{ "key": "cash_asset_uuid", "value": "", "type": "string" },
		{ "key": "expense_uuid", "value": "", "type": "string" },
		{ "key": "income_uuid", "value": "", "type": "string" },
		{ "key": "saving_goal_uuid", "value": "", "type": "string" },
		{ "key": "debt_uuid", "value": "", "type": "string" },
		{ "key": "receivable_uuid", "value": "", "type": "string" },
		{ "key": "category_uuid", "value": "" },
		{ "key": "income_category_uuid", "value": "" },
		{ "key": "reassign_category_uuid", "value": "" }
	],
	"item": [
		{
			"name": "Auth",
			"description": "Register, Login, Refresh token, Me (current user), Logout. Me and Logout require Bearer token.",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"  var json = pm.response.json();",
									"  pm.collectionVariables.set('token', json.data.Token);",
									"  pm.collectionVariables.set('refresh_token', json.data.RefreshToken);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@monity.com\",\n  \"password\": \"password123\",\n  \"name\": \"John Doe\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "register"]
						}
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"  var json = pm.response.json();",
									"  pm.collectionVariables.set('token', json.data.Token);",
									"  pm.collectionVariables.set('refresh_token', json.data.RefreshToken);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@monity.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					}
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"  var json = pm.response.json();",
									"  pm.collectionVariables.set('token', json.data.Token);",
									"  pm.collectionVariables.set('refresh_token', json.data.RefreshToken);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/refresh",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "refresh"]
						}
					}
				},
				{
					"name": "Me",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/me",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "me"]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "logout"]
						}
					}
				}
			]
		},
		{
			"name": "Activities",
			"description": "List incomes and expenses grouped by day, month, or year. Single chronological list per group.\n\nQuery: group_by (day|month|year), date (empty|today|YYYY-MM-DD), tz (optional IANA timezone, e.g. Asia/Jakarta).\nPrefer date=YYYY-MM-DD for \"today\" from device (client sends that date).",
			"item": [
				{
					"name": "List Activities (by day)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{base_url}}/api/v1/activities",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "activities"]
						}
					}
				},
				{
					"name": "List Activities (today)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{base_url}}/api/v1/activities?group_by=day&date=today",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "activities"],
							"query": [{ "key": "group_by", "value": "day" }, { "key": "date", "value": "today" }]
						}
					}
				},
				{
					"name": "List Activities (today, timezone)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{base_url}}/api/v1/activities?group_by=day&date=today&tz=Asia/Jakarta",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "activities"],
							"query": [
								{ "key": "group_by", "value": "day" },
								{ "key": "date", "value": "today" },
								{ "key": "tz", "value": "Asia/Jakarta", "description": "IANA timezone" }
							]
						}
					}
				},
				{
					"name": "List Activities (by month)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{base_url}}/api/v1/activities?group_by=month",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "activities"],
							"query": [{ "key": "group_by", "value": "month" }]
						}
					}
				},
				{
					"name": "List Activities (by year)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{base_url}}/api/v1/activities?group_by=year",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "activities"],
							"query": [{ "key": "group_by", "value": "year" }]
						}
					}
				},
				{
					"name": "List Activities (specific date)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{base_url}}/api/v1/activities?group_by=day&date=2026-02-14",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "activities"],
							"query": [
								{ "key": "group_by", "value": "day" },
								{ "key": "date", "value": "2026-02-14", "description": "YYYY-MM-DD; prefer this for \"today\" from device" }
							]
						}
					}
				}
			]
		},
		{
