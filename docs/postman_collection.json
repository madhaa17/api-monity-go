		{
			"name": "Asset Price History",
			"description": "Manual price recording for non-digital assets (CASH, LIVESTOCK, REAL_ESTATE) and auto-fetch for CRYPTO/STOCK.\n\nUsed by portfolio to determine current value of non-digital assets.",
			"item": [
				{
					"name": "Record Price (manual)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"price\": 12000000,\n  \"source\": \"market_estimate\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/assets/:uuid/prices",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "assets", ":uuid", "prices"],
							"variable": [
								{ "key": "uuid", "value": "{{asset_uuid}}", "description": "Asset UUID" }
							]
						}
					}
				},
				{
					"name": "Get Price History",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{base_url}}/api/v1/assets/:uuid/prices?limit=10",
