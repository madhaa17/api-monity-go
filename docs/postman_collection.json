						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{base_url}}/api/v1/assets/:uuid/prices/fetch",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "assets", ":uuid", "prices", "fetch"],
							"variable": [
								{ "key": "uuid", "value": "{{asset_uuid}}", "description": "Asset UUID (must be CRYPTO or STOCK)" }
							]
						}
					}
				}
			]
		},
		{
			"name": "Categories",
			"description": "Per-user INCOME/EXPENSE categories. New users get defaults (Food, Transport, … / Salary, Bonus, …). A category still in use can only be deleted with `reassign_to`.",
